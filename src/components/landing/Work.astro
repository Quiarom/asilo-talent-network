---
import { allCasesHref, workCases } from "../../data/landing";
---
<section class="l-section" id="trabajo" aria-labelledby="trabajo-title">
  <div class="l-container">
    <div class="l-section-head l-section-head--split" data-reveal>
      <div>
        <span class="l-eyebrow">Trabajo</span>
        <h2 class="l-heading" id="trabajo-title">Trabajo reciente, diseñado para que se use.</h2>
      </div>
      <a class="l-link" href={allCasesHref}>
        Ver todos los casos
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" /></svg>
      </a>
    </div>

    <ul class="l-work-grid">
      {workCases.map((item, i) => (
        <li class:list={["l-card", "l-case", { "l-case--featured": i === 0 }]} data-reveal style={`--reveal-i: ${i % 2}`}>
          <article>
            <div class="l-media">
              <img src={item.image.src} alt={item.image.alt} width="1600" height="1200" loading="lazy" decoding="async" />
            </div>
            <div class="l-case-body">
              <div class="l-case-meta">
                <span class="l-tag l-tag--pill">{item.service}</span>
                <span class="l-tag">{item.year}</span>
              </div>
              <h3>{item.name}</h3>
              <p>{item.problem}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
