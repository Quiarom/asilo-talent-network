---
// Logo de Asilo Digital (isotipo + wordmark). Se usa en el header, el menú móvil y el footer.
interface Props {
  href?: string;
}

const { href = "#inicio" } = Astro.props;
---
<a class="l-logo" href={href} aria-label="Asilo Digital, ir al inicio">
  <img src="/logo-asilo-digital.svg" alt="" width="164" height="24" />
</a>
