---
import type { Project } from "../data/projects";
import { SORT_OPTIONS, type SortMode } from "../lib/project-sort";
import ProjectFormModal from "./ProjectFormModal.astro";
import ProjectPages from "./ProjectPages.astro";

interface Props {
  projects: Project[];
  sort?: SortMode;
  /** Likes configured: enables the "Más votados" order. */
  likesEnabled?: boolean;
}

const { projects, sort = "az", likesEnabled = false } = Astro.props;
const sortOptions = SORT_OPTIONS.filter((option) => likesEnabled || option.value !== "populares");
---

<section class="prj" id="proyectos">
  <div class="prj-inner">
    <div class="prj-head">
      <h2 class="prj-title" data-decode>Proyectos</h2>
      <!-- Works without JS (GET reload); with JS it swaps in the sorted partial. -->
      <form class="prj-sort" method="get" action="/#proyectos" data-project-sort>
        <label class="prj-sort-label" for="project-sort">Ordenar</label>
        <select class="prj-sort-select" id="project-sort" name="orden">
          {sortOptions.map((option) => (
            <option value={option.value} selected={option.value === sort}>{option.label}</option>
          ))}
        </select>
        <noscript><button class="prj-sort-go" type="submit">Aplicar</button></noscript>
      </form>
      <div class="prj-nav">
        <button class="prj-arrow" type="button" aria-label="Anterior" aria-controls="project-directory-list" data-project-nav="previous">
          <svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M16 26V22H20V26H16ZM20 22V18H24V22H20ZM20 30V26H24V30H20ZM24 18V14H28V18H24ZM24 34V30H28V34H24ZM28 14V10H32V14H28ZM28 38V34H32V38H28Z" /></svg>
        </button>
        <button class="prj-arrow" type="button" aria-label="Siguiente" aria-controls="project-directory-list" data-project-nav="next">
          <svg viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M32 26V22H28V26H32ZM28 22V18H24V22H28ZM28 30V26H24V30H28ZM24 18V14H20V18H24ZM24 34V30H20V34H24ZM20 14V10H16V14H20ZM20 38V34H16V38H20Z" /></svg>
        </button>
      </div>
    </div>
    <div class="prj-carousel" id="project-directory-list" aria-busy="false">
      <ProjectPages projects={projects} />
    </div>
    <div class="prj-cta-row">
      <p class="prj-cta-text">¿Construiste algo? Súmalo al directorio. No hace falta volver a registrarte en la comunidad.</p>
      <button class="prj-cta" type="button" data-open-modal>AGREGA TU PROYECTO</button>
    </div>
  </div>
</section>

<ProjectFormModal mode="create" />

<script>
  import { gsap } from "gsap";
  import { paintLikes } from "../scripts/likes";

  const projectCarousel = document.getElementById("project-directory-list");
  const sortForm = document.querySelector<HTMLFormElement>("[data-project-sort]");
  const sortSelect = sortForm?.querySelector<HTMLSelectElement>("select") ?? null;
  let projectPages = Array.from(document.querySelectorAll<HTMLElement>("[data-project-page]"));
  const projectNavButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-nav]"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let projectPageIndex = 0;
  let projectPageAnimating = false;
  let lastPartial = "";

  // The server renders the cards (see /partials/proyectos); the browser only
  // swaps HTML in, so card markup exists in exactly one place.
  const loadPartial = async (sort: string, { force = false } = {}) => {
    if (!projectCarousel) return;
    const response = await fetch(`/partials/proyectos?orden=${encodeURIComponent(sort)}`, {
      headers: { accept: "text/html" },
    });
    if (!response.ok) throw new Error(`partial ${response.status}`);
    const html = await response.text();
    if (!force && html === lastPartial) return;
    lastPartial = html;
    projectCarousel.innerHTML = html;
    projectPages = Array.from(projectCarousel.querySelectorAll<HTMLElement>("[data-project-page]"));
    projectPageIndex = 0;
    paintLikes(projectCarousel);
  };

  const currentSort = () => sortSelect?.value ?? "az";

  const refreshProjects = async () => {
    // Don't yank cards away from someone browsing later pages.
    if (document.visibilityState !== "visible" || projectPageIndex !== 0 || projectPageAnimating) return;
    try {
      await loadPartial(currentSort());
    } catch {
      // Keep the last rendered directory when a background refresh fails.
    }
  };

  window.setInterval(refreshProjects, 60_000);
  document.addEventListener("visibilitychange", refreshProjects);

  sortSelect?.addEventListener("change", async () => {
    const sort = currentSort();
    const url = new URL(window.location.href);
    url.searchParams.set("orden", sort);
    history.replaceState(null, "", url);
    projectCarousel?.setAttribute("aria-busy", "true");
    try {
      await loadPartial(sort, { force: true });
    } catch {
      // Progressive enhancement: fall back to the plain GET form.
      sortForm?.submit();
    } finally {
      projectCarousel?.setAttribute("aria-busy", "false");
    }
  });

  const showProjectPage = (nextPageIndex: number) => {
    if (projectPages.length === 0 || projectPageAnimating || nextPageIndex === projectPageIndex) return;

    const currentPage = projectPages[projectPageIndex];
    const nextPage = projectPages[nextPageIndex];
    const currentCards = Array.from(currentPage.querySelectorAll<HTMLElement>(".prj-item"));
    const nextCards = Array.from(nextPage.querySelectorAll<HTMLElement>(".prj-item"));
    const complete = () => {
      projectPageAnimating = false;
      projectNavButtons.forEach((button) => { button.disabled = false; });
      gsap.set([...currentCards, ...nextCards], { clearProps: "willChange" });
      const firstCard = nextCards[0];
      firstCard?.querySelector<HTMLElement>(".prj-link")?.focus({ preventScroll: true });
      firstCard?.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "nearest" });
    };
    const swapPages = () => {
      currentPage.hidden = true;
      currentPage.setAttribute("aria-hidden", "true");
      nextPage.hidden = false;
      nextPage.setAttribute("aria-hidden", "false");
      projectPageIndex = nextPageIndex;
    };

    if (reduceMotion) {
      swapPages();
      complete();
      return;
    }

    projectPageAnimating = true;
    projectNavButtons.forEach((button) => { button.disabled = true; });
    gsap.set([...currentCards, ...nextCards], { willChange: "transform,opacity" });
    gsap.timeline({ onComplete: complete })
      .to(currentCards, {
        autoAlpha: 0,
        y: -8,
        duration: 0.14,
        ease: "power2.in",
        stagger: { each: 0.015, from: "end" },
      })
      .call(swapPages)
      .fromTo(
        nextCards,
        { autoAlpha: 0, y: 16 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.5,
          ease: "power1.out",
          stagger: 0.06,
        },
      );
  };

  projectNavButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (projectPages.length === 0) return;
      const step = button.dataset.projectNav === "next" ? 1 : -1;
      const nextPageIndex = (projectPageIndex + step + projectPages.length) % projectPages.length;
      showProjectPage(nextPageIndex);
    });
  });
</script>
