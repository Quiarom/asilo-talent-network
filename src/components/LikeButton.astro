---
/**
 * Like toggle. Server renders the count; `src/scripts/likes.ts` restores the
 * visitor's pressed state and handles clicks through event delegation, so
 * buttons inserted later (directory refresh, sorting) work without rebinding.
 */
interface Props {
  projectId: string;
  title: string;
  likes: number;
  size?: "sm" | "lg";
}

const { projectId, title, likes, size = "sm" } = Astro.props;
---

<button class:list={["like", size === "lg" && "button button-secondary"]} type="button" data-like={projectId} aria-pressed="false">
  <svg class="like-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path class="like-fill" d="M5 4h4v2H5zm10 0h4v2h-4zM3 6h8v2H3zm10 0h8v2h-8zM3 8h18v4H3zm2 4h14v2H5zm2 2h10v2H7zm2 2h6v2H9zm2 2h2v2h-2z" />
    <path d="M13 22h-2v-2h2zm-2-2H9v-2h2zm4 0h-2v-2h2zm-6-2H7v-2h2zm8 0h-2v-2h2zM7 16H5v-2h2zm12 0h-2v-2h2zM5 14H3v-2h2zm16 0h-2v-2h2zM3 12H1V6h2zm20 0h-2V6h2zM13 8h-2V6h2zM5 6H3V4h2zm6 0H9V4h2zm4 0h-2V4h2zm6 0h-2V4h2zM9 4H5V2h4zm10 0h-4V2h4z" />
  </svg>
  <span class="like-count" data-like-count>{likes}</span>
  <span class="sr-only">me gusta para {title}</span>
</button>
