---
import "../styles/fonts.css";
import "../styles/landing.css";
import SeoHead from "../components/SeoHead.astro";
import Nav from "../components/landing/Nav.astro";
import Hero from "../components/landing/Hero.astro";
import Services from "../components/landing/Services.astro";
import Process from "../components/landing/Process.astro";
import Work from "../components/landing/Work.astro";
import Testimonials from "../components/landing/Testimonials.astro";
import About from "../components/landing/About.astro";
import ContactCta from "../components/landing/ContactCta.astro";
import Footer from "../components/landing/Footer.astro";
import { seo } from "../data/landing";

export const prerender = true;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://builders.asilodigital.com";
const canonical = `${siteUrl}/servicios`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafafa" />
    <SeoHead
      title={seo.title}
      description={seo.description}
      canonical={canonical}
      image={`${siteUrl}/og-servicios.png`}
      siteName="Asilo Digital"
    />
    <link rel="icon" href="/favicon.svg?v=20260911" type="image/svg+xml" />
    <link rel="preload" href="/fonts/geist-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="landing">
    <a class="l-skip" href="#contenido">Saltar al contenido</a>
    <Nav />
    <main id="contenido">
      <Hero />
      <Services />
      <Process />
      <Work />
      <Testimonials />
      <About />
      <ContactCta />
    </main>
    <Footer />
    <script>
      import "../scripts/scroll-reveal.js";
      import "../scripts/landing.ts";
    </script>
  </body>
</html>
