# Copy this file to .env.local for local development.
# Set the same variables in your hosting environment for production.
# Never commit real credentials. Keep secret keys server-only.
# TURNSTILE_SITE_KEY is public and is embedded in the page for the captcha widget.

# Base64-encoded JSON key for the existing Google service account.
# Share the member-count spreadsheet with the key's client_email as Viewer.
# Application and project submissions require Editor access on their documents.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ID of the NEW, separate spreadsheet for membership applications (not its full URL).
# From https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit, copy SPREADSHEET_ID.
# Create a "Builders" tab with the headers in docs/community-form.md and share the
# spreadsheet with the Google service account as Editor. Do not use the project
# directory spreadsheet here. Leave blank until ready; submissions will be unavailable.
GOOGLE_COMMUNITY_SHEETS_ID=

# Members spreadsheet ID, NOT the full URL.
# Use your member roster, not the pending-application spreadsheet above.
# For https://docs.google.com/spreadsheets/d/ABC123/edit, enter ABC123.
# This can be a separate document from the projects spreadsheet.
# If empty, the loader falls back to GOOGLE_SHEETS_ID below.
GOOGLE_BUILDERS_SHEETS_ID=

# One identifying column, starting after its header; one row per member.
# Empty cells are ignored. Choose a column filled for every member.
# For a tab with spaces, use: "'Community Members'!A2:A"
GOOGLE_BUILDERS_SHEETS_RANGE="Builders!A2:A"

# Existing projects integration: spreadsheet ID and table range.
# Project submissions require Editor access for the service account on this document.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE="Projects!A1:J"

# The member count is cached in server memory for 10 minutes per instance.
# Simultaneous requests share one Google read. Failed reads wait 10 minutes
# before retrying and keep the last successful count, if available.
# A new server instance starts with an empty cache; no cache env variable is needed.

# Optional project logos. Default preserves Appwrite; set s3 to change new uploads.
# See docs/logo-storage.md for migration, public reads, and rollback.
LOGO_STORAGE_PROVIDER=appwrite

# Appwrite: required for uploads when provider=appwrite. Endpoint/project also
# serve historical bare file IDs until LOGO_LEGACY_PUBLIC_BASE_URL is set.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# S3-compatible storage (R2, AWS S3, etc.): all except ENDPOINT are required
# when provider=s3. Leave ENDPOINT empty for AWS, use R2's S3 API endpoint for R2.
# REGION: auto for R2, the bucket's AWS region for S3. All credentials server-only.
LOGO_S3_ENDPOINT=
LOGO_S3_REGION=
LOGO_S3_BUCKET=
LOGO_S3_ACCESS_KEY_ID=
LOGO_S3_SECRET_ACCESS_KEY=
LOGO_S3_FORCE_PATH_STYLE=false
# Permanent public bucket/CDN base, NOT the S3 API endpoint or a signed URL.
LOGO_S3_PUBLIC_BASE_URL=

# Set ONLY after copying all old logos with their exact Appwrite IDs as keys.
# Example: https://logos.example.com/legacy -> /legacy/<old-file-id>
# Works with any public object store. Empty keeps legacy reads on Appwrite.
LOGO_LEGACY_PUBLIC_BASE_URL=

# Optional Turnstile protection for project submissions: set both or leave both blank.
# The site key is public; the secret key must remain server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local development only: allow repeated project website submissions.
# Ignored outside development. Leave false for normal duplicate checks.
DEV_ALLOW_DUPLICATE_WEBSITE=false
