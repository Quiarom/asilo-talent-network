# Copy to .env.local for development. Names only — never commit real values.

# Projects directory (Google Sheet, private). Without these the homepage shows
# placeholder cards and submissions answer 503.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SHEETS_RANGE=Projects!A1:J

# Appwrite: logo uploads + likes/comments. Create the tables once with
#   node scripts/setup-appwrite.mjs
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=builders
# Key for hashing voter cookies and IPs before storing them (any long random
# string). Falls back to APPWRITE_API_KEY when unset.
ENGAGEMENT_SECRET=

# Cloudflare Turnstile captcha (strongly recommended in production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Community sign-up form (Tally / Typeform / Google Form). Public.
PUBLIC_COMMUNITY_JOIN_URL=

# Dev only: skip the duplicate-website check to re-test submissions.
DEV_ALLOW_DUPLICATE_WEBSITE=

# Dev only: run on fictional data with an in-memory likes/comments store.
DEMO_DATA=
